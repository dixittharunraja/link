# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# trash bin
.trash_bin/

# temporary build paths
/api-temp/
/dist/
/dist_electron/

# installer binaries
*.apk
*.exe
*.AppImage
*.deb

# reference-only clones (KDE Connect source, read locally for the port — not our code, not distributed)
/reference/

# signing keys — never committed
/keys/

# Android build output (Gradle)
/android/app/build
/android/.gradle
/android/build
/android/capacitor-cordova-android-plugins/build

# branding assets
/assets/

# Android local properties & SDK paths
local.properties
**/local.properties

# JetBrains IDE settings (Android Studio, WebStorm, etc.)
.idea/

node_modules/
desktop/node_modules/
