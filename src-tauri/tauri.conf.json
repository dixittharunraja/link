{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Link",
  "version": "../package.json",
  "identifier": "in.rodix.link",
  "build": {
    "frontendDist": "../dist/renderer",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Link",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "maximized": true,
        "visible": false,
        "focus": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-renderer-backgrounding --disable-background-timer-throttling --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rodix",
    "copyright": "Copyright \u00a9 2026 Rodix",
    "category": "Utility",
    "shortDescription": "Your phone and PC as one set of devices, over your own network.",
    "longDescription": "Link connects your Android phone and Windows PC peer to peer on your own network: clipboard and file sharing, notification mirroring, a phone-storage drive, screen and camera sharing (including the phone as a webcam), remote input and more. No cloud, no accounts.",
    "homepage": "https://github.com/dixittharunraja/link",
    "license": "GPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    },
    "android": {
      "minSdkVersion": 29,
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
