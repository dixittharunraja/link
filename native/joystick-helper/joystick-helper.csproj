<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Builds joystick-helper.exe: a small stdin/stdout glue process that plugs up to 4 virtual
    Xbox 360 controllers via ViGEmBus (through the Nefarius.ViGEm.Client NuGet library) and
    relays analog stick/button/trigger state in, and rumble (force-feedback) state out.

    Unlike desktop/src/core/plugins/touchpad.ts's mouse-helper.cs (which is compiled on the
    end user's own machine at first run via the bundled csc.exe, using only P/Invoke against
    user32.dll — zero external dependencies), this helper depends on a NuGet package and must
    be built ahead of time here with the .NET SDK:

      dotnet publish -c Release -r win-x64 -o out

    Self-contained + single-file (see PropertyGroup below): the vendored exe must run on an end
    user's machine with no .NET runtime installed at all, matching how desktop/vendor/rclone/
    rclone.exe is just one standalone binary — a framework-dependent build would additionally
    require the .NET 8 runtime AND several companion DLLs sitting next to the exe, neither of
    which end users should ever need to think about.

    The resulting joystick-helper.exe is committed to desktop/vendor/joystick-helper/ and its
    SHA-256 is pinned in desktop/src/core/plugins/joystick.ts (see JOYSTICK_HELPER_PINNED_SHA256),
    exactly like desktop/vendor/rclone/rclone.exe is pinned in fs-mount-service.ts. Regenerate
    that hash whenever this project is rebuilt and re-vendored.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>JoystickHelper</RootNamespace>
    <AssemblyName>joystick-helper</AssemblyName>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

</Project>
