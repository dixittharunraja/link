<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>link-fs-driver</AssemblyName>
    <RootNamespace>Link.FsDriver</RootNamespace>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
    <!-- Self-contained publish bundles the .NET runtime so users need no separate install. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- WinFsp itself (kernel driver) is installed by the bundled MSI. The managed
       winfsp-msil.dll is copied beside the exe so the CLR finds it without the WinFsp
       bin directory on PATH; it locates the native DLL through the WinFsp registry key. -->
  <ItemGroup>
    <Reference Include="WinFspNet">
      <HintPath>$(MSBuildProgramFiles32)\WinFsp\bin\winfsp-msil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- WinFsp's managed assembly checks its own file version through Assembly.Location, which is
       empty for anything inside a single-file bundle, so it stays beside the exe. -->
  <Target Name="KeepWinFspBesideExe" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)%(Extension)' == 'winfsp-msil.dll'" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
