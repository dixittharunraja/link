    "rect": [
      40.42339348837209,
      408.6638958139535,
      291.8236762790698,
      419.7387981395349
    ],
    "text": "self-signed cryptographic certificates or pre-shared keys. While"
  },
  {
    "report_page": 4,
    "rect": [
      40.42339348837209,
      420.29254325581394,
      291.8236762790698,
      431.92119069767443
    ],
