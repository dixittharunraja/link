  {
    "report_page": 4,
    "rect": [
      40.42339348837209,
      336.67703069767435,
      291.8236762790698,
      348.30567813953485
    ],
    "text": "failure, exposes personal metadata to cloud providers and"
  },
  {
    "report_page": 4,
    "rect": [
      40.42339348837209,
      348.85942325581397,
      291.8236762790698,
      359.93432558139534
    ],
    "text": "nearby observers [3], [4], and enforces proprietary vendor"
