{
  "name": "link",
  "version": "0.1.0",
  "description": "Link — secure peer-to-peer local network device synchronization and control suite",
  "author": "Rodix",
  "homepage": "https://github.com/dixittharunraja/link",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dixittharunraja/link.git"
  },
  "bugs": {
    "url": "https://github.com/dixittharunraja/link/issues"
  },
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "gen:phone-portal": "node scripts/gen-phone-portal-page.mjs",
    "build": "npm run build:vite",
    "tauri": "tauri",
    "dev": "tauri dev",
    "dev:vite": "vite --host 0.0.0.0 --strictPort --port 5173",
    "build:vite": "vite build --base=./",
    "build:windows": "node scripts/build.mjs windows",
    "build:android": "node scripts/build.mjs android",
    "doctor": "node scripts/build.mjs doctor",
    "build:all": "node scripts/build.mjs all",
    "clean": "node scripts/build.mjs clean",
    "signing:create": "node scripts/signing-key.mjs",
    "install:windows": "node scripts/install-windows.mjs",
    "install:android": "node scripts/install-android.mjs",
    "prepare": "husky",
    "lint": "eslint src",
    "test": "vitest run",
    "knip": "knip",
    "dupes": "jscpd src",
    "dev:android": "powershell -Command \"& ${env:LOCALAPPDATA}\\Android\\Sdk\\platform-tools\\adb.exe reverse tcp:5173 tcp:5173; tauri android dev --target aarch64 --host 127.0.0.1\""
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.2.12",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
